{
  "name": "truthiness",
  "version": "0.2.0",
  "description": "Git-backed memory for coding agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchimestre/truthiness.git"
  },
  "files": [
    "src/agent.ts",
    "src/axioms.ts",
    "src/bootstrap.ts",
    "src/cli.ts",
    "src/hook.ts",
    "src/lookup.ts",
    "src/review.ts",
    "src/store.ts",
    ".omp/hooks/pre/truthiness.ts",
    "scripts/truthiness-reviewer.sh",
    "scripts/truthiness-tokenizer.sh",
    "assets/hero.svg",
    "assets/lifecycle.svg"
  ],
  "type": "module",
  "packageManager": "bun@1.4.4",
  "bin": {
    "truthiness": "src/cli.ts"
  },
  "scripts": {
    "truthiness": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "19.0.1",
    "@types/bun": "1.4.4",
    "typescript": "5.9.3"
  }
}
